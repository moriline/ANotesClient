# Скопируйте нужные строки в .env.production.local (не попадает в git, см.
# .gitignore: *.local) — Vite сам подхватит его при `npm run build`.
# Подробнее — DEVELOPMENT.md, раздел «Адрес бэкенда».

# Адрес бэкенда, если он НЕ на одном origin с этим фронтендом — например,
# при раздельном деплое (свой домен для API). Без завершающего /.
# Пусто (или отсутствует) = /api резолвится относительно текущего домена —
# так и раньше, нужен общий реверс-прокси перед фронтендом и бэкендом.
# VITE_API_URL=https://api.example.com

# Базовый путь сборки — нужен только для деплоя не в корень домена
# (например, GitHub Pages: /ИмяРепозитория/). Смотрите также .env.demo.
# VITE_BASE=/
